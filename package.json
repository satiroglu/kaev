{
  "name": "@satiroglu/kaev",
  "version": "0.1.0",
  "description": "Local SAPUI5/Fiori project health, security and architecture analysis",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "kaev": "dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "keywords": [
    "sapui5",
    "openui5",
    "fiori",
    "security",
    "static-analysis",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:pack": "node scripts/verify-pack.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ui5/linter": "1.23.6",
    "commander": "^13.1.0",
    "jsonc-parser": "^3.3.1",
    "saxes": "^6.0.0",
    "semver": "^7.7.2",
    "typescript": "~5.8.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.7.0",
    "vitest": "4.1.11"
  }
}
